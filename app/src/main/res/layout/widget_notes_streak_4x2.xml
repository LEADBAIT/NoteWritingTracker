<?xml version="1.0" encoding="utf-8"?>
<!--
    4×2 widget — wide horizontal layout.
    Left: flame + streak number (hero) + DAY STREAK label.
    Right: logged status + best streak.
    Place at: NoteWritingTracker/app/src/main/res/layout/widget_notes_streak_4x2.xml
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <!-- LEFT: flame + number + label, centred -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_flame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥"
            android:textSize="24sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0"
            android:textSize="46sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAY STREAK"
            android:textSize="8sp"
            android:textColor="#606080"
            android:letterSpacing="0.15"
            android:gravity="center" />

    </LinearLayout>

    <!-- Thin vertical divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="50dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#2A2A4A" />

    <!-- RIGHT: status + best streak, left-aligned -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_logged_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E" />

        <TextView
            android:id="@+id/tv_longest_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="11sp"
            android:textColor="#404060" />

    </LinearLayout>

</LinearLayout>
