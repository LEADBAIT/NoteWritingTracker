<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget background: two-layer effect.
    Layer 1 — very dark navy base (#0D0D1E) with rounded corners.
    Layer 2 — soft radial amber glow centred near the bottom, 10% opacity,
               mimicking embers beneath the flame. Purely gradient, no images.
    Place at: NoteWritingTracker/app/src/main/res/drawable/widget_background.xml
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0D1E" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:centerX="0.5"
                android:centerY="0.88"
                android:startColor="#1AFF8C00"
                android:endColor="#00FF8C00" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</layer-list>
