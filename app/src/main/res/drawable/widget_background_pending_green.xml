<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D1A0F" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Green glow — morning, plenty of time (06:00–11:59) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="110dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#264CAF50"
                android:endColor="#004CAF50" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item android:top="0dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1E4A2A" />
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>

</layer-list>
