<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark green-tinted base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A1A0A" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Strong green radial glow — morning, plenty of time (06:00–11:59) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#80388E3C"
                android:endColor="#00388E3C" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Clearly visible green border ring -->
    <item android:top="0dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#388E3C" />
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>

</layer-list>
