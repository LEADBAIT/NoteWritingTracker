<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark red base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A0000" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Heavy red radial glow — last chance, alarm state (21:00–23:59) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#99B71C1C"
                android:endColor="#00B71C1C" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Bright red border ring — unmissable urgency -->
    <item android:top="0dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#F44336" />
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>

</layer-list>
