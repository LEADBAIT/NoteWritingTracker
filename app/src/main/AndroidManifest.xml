<?xml version="1.0" encoding="utf-8"?>
<!-- Place at: NoteWritingTracker/app/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Resizable widget: starts at 2×2, can be widened to 4×2.
             WIDGET_TAP triggers double-tap detection inside the receiver. -->
        <receiver
            android:name=".NotesStreakWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.leadbait.notewritingtracker.WIDGET_TAP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notes_streak_widget_info" />
        </receiver>

        <!-- Compact 2×1 widget: width of two app icons, one row tall -->
        <receiver
            android:name=".NotesStreakWidgetSmall"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.leadbait.notewritingtracker.WIDGET_TAP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notes_streak_widget_info_small" />
        </receiver>

        <!-- Confirmation dialog: opened on double-tap, never appears in recents -->
        <activity
            android:name=".LogConfirmationActivity"
            android:theme="@style/ConfirmDialogTheme"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

    </application>

</manifest>
